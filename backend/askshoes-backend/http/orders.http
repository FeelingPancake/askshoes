> {% client.test("200", () => client.assert(response.status === 200)); client.global.set("st_regular", response.body.id); %}


### ============================================================ A. Создание
### A1 Создание: 2 изделия, гарантия обнуляет работы, скидка 10%
# изделие 1: 1500 + 800 = 2300; изделие 2 (гарантия): 0
# worksTotal 2300, скидка 230.00, total 2070.00, оплачено 1000 → к оплате 1070.00
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "client": {
    "fullName": "Регресс Тест", "phone": "{{phoneRaw}}", "address": "ул. Тестовая, 1",
    "login": "@regress", "sourceId": "{{src}}", "statusId": "{{st_regular}}",
    "contactMethodIds": ["{{cm_phone}}"]
  },
  "dueDate": "2026-12-01", "note": "регресс", "paidAmount": 1000,
  "items": [
    {
      "categoryId": "{{cat_shoes}}", "itemTypeId": "{{type_boots}}", "brandId": "{{brand_plain}}",
      "warranty": false, "colorId": "{{color}}", "materialId": "{{material}}", "sizeId": "{{size_42}}",
      "wearPercent": 30, "comment": "левый каблук",
      "defectTypeIds": ["{{def_scuff}}", "{{def_crack}}"],
      "works": [
        {"serviceTypeId": "{{svc_heel}}", "price": 1500},
        {"serviceTypeId": "{{svc_clean}}", "price": 800}
      ]
    },
    {
      "categoryId": "{{cat_bags}}", "itemTypeId": "{{type_bag}}", "brandId": "{{brand_warranty}}",
      "warranty": true,
      "works": [{"serviceTypeId": "{{svc_clean}}", "price": 800}]
    }
  ]
}

> {%
  const b = response.body;
  client.test("201", () => client.assert(response.status === 201, "status " + response.status));
  client.test("статус NEW", () => client.assert(b.status.code === "NEW", b.status.code));
  client.test("клиент: телефон нормализован", () => client.assert(b.client.phone === client.global.get("phoneNorm"), b.client.phone));
  client.test("2 изделия", () => client.assert(b.itemsCount === 2 && b.items.length === 2));
  client.test("worksTotal 2300", () => client.assert(b.worksTotal == 2300, b.worksTotal));
  client.test("скидка 10% = 230", () => client.assert(b.discountPercent == 10 && b.discountAmount == 230, b.discountAmount));
  client.test("total 2070", () => client.assert(b.total == 2070, b.total));
  client.test("к оплате 1070", () => client.assert(b.amountDue == 1070, b.amountDue));
  client.test("изделие 1: 2300, seqNo 1, номер", () => client.assert(
      b.items[0].worksTotal == 2300 && b.items[0].seqNo === 1 && b.items[0].number === b.number + "-1/2"));
  client.test("изделие 1: 2 повреждения", () => client.assert(b.items[0].defectTypeIds.length === 2));
  client.test("изделие 2 (гарантия): работы по 0", () => client.assert(
      b.items[1].worksTotal == 0 && b.items[1].works[0].total == 0 && b.items[1].works[0].price == 800));
  client.global.set("order_id", b.id);
  client.global.set("order_number", b.number);
  client.global.set("item1_id", b.items[0].id);
  client.global.set("item2_id", b.items[1].id);
  client.global.set("item1_heel_id", b.items[0].works.find(w => w.serviceTypeId === client.global.get("svc_heel")).id);
%}

### A2 Чтение по id
GET {{host}}/api/orders/{{order_id}}
Authorization: Bearer {{token}}

> {%
  const b = response.body;
  client.test("200", () => client.assert(response.status === 200));
  client.test("суммы как при создании", () => client.assert(b.total == 2070 && b.amountDue == 1070));
%}

### A3 Список: поиск по номеру
GET {{host}}/api/orders?search={{order_number}}
Authorization: Bearer {{token}}

> {%
  const rows = response.body.content;
  client.test("200", () => client.assert(response.status === 200));
  const row = rows.find(r => r.id === client.global.get("order_id"));
  client.test("заказ найден по номеру", () => client.assert(row !== undefined));
  client.test("строка списка: клиент, статус, суммы", () => client.assert(
      row.clientName === "Регресс Тест" && row.statusName === "Новый" && row.total == 2070 && row.itemsCount === 2));
%}

### A4 Список: поиск по 7 последним цифрам телефона
# Поиск — LIKE по цифрам в нормализованном 7XXXXXXXXXX, поэтому «8…» целиком не найдётся — только хвост.
GET {{host}}/api/orders?search={{phoneTail}}
Authorization: Bearer {{token}}

> {%
  client.test("заказ найден по хвосту телефона", () => client.assert(
      response.body.content.some(r => r.id === client.global.get("order_id"))));
%}

### A5 Клиент по телефону (8XXXXXXXXXX → 7XXXXXXXXXX)
GET {{host}}/api/clients/by-phone?phone={{phone8}}
Authorization: Bearer {{token}}

> {%
  const b = response.body;
  client.test("200", () => client.assert(response.status === 200));
  client.test("поля клиента", () => client.assert(
      b.phone === client.global.get("phoneNorm") && b.statusId === client.global.get("st_regular")
      && b.contactMethodIds.length === 1));
%}


### ============================================================ U. Обновление
### U1 Обновление: изделие 1 меняется, изделие 2 удаляется, изделие 3 добавляется
# изделие 1: каблук 2000 (тот же id) + новая чистка 800 = 2800, повреждения → только трещина
# изделие 3: чистка 800, без гарантии
# worksTotal 3600, скидка 360.00, total 3240.00, к оплате 2240.00
PUT {{host}}/api/orders/{{order_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "client": {
    "fullName": "Регресс Тест", "phone": "{{phoneRaw}}", "sourceId": "{{src}}",
    "statusId": "{{st_regular}}", "contactMethodIds": ["{{cm_phone}}"]
  },
  "dueDate": "2026-12-05", "note": "обновлён", "paidAmount": 1000,
  "items": [
    {
      "id": "{{item1_id}}",
      "categoryId": "{{cat_shoes}}", "itemTypeId": "{{type_boots}}", "brandId": "{{brand_plain}}",
      "warranty": false, "colorId": "{{color}}", "materialId": "{{material}}", "sizeId": "{{size_42}}",
      "wearPercent": 40,
      "defectTypeIds": ["{{def_crack}}"],
      "works": [
        {"id": "{{item1_heel_id}}", "serviceTypeId": "{{svc_heel}}", "price": 2000},
        {"serviceTypeId": "{{svc_clean}}", "price": 800}
      ]
    },
    {
      "categoryId": "{{cat_bags}}", "itemTypeId": "{{type_bag}}", "brandId": "{{brand_plain}}",
      "warranty": false,
      "works": [{"serviceTypeId": "{{svc_clean}}", "price": 800}]
    }
  ]
}

> {%
  const b = response.body;
  const g = k => client.global.get(k);
  client.test("200", () => client.assert(response.status === 200, "status " + response.status));
  const item1 = b.items.find(i => i.id === g("item1_id"));
  const item3 = b.items.find(i => i.id !== g("item1_id"));
  client.test("2 изделия", () => client.assert(b.itemsCount === 2 && b.items.length === 2));
  client.test("изделие 1 сохранило id и seqNo 1", () => client.assert(item1 && item1.seqNo === 1));
  client.test("изделие 2 удалено", () => client.assert(!b.items.some(i => i.id === g("item2_id"))));
  client.test("новое изделие получило seqNo 2", () => client.assert(item3 && item3.seqNo === 2 && item3.number === b.number + "-2/2"));
  client.test("каблук: тот же id, цена 2000", () => {
    const heel = item1.works.find(w => w.id === g("item1_heel_id"));
    client.assert(heel && heel.price == 2000 && heel.total == 2000);
  });
  client.test("изделие 1: 2 работы, 2800", () => client.assert(item1.works.length === 2 && item1.worksTotal == 2800));
  client.test("изделие 1: осталась только трещина", () => client.assert(
      item1.defectTypeIds.length === 1 && item1.defectTypeIds[0] === g("def_crack")));
  client.test("изделие 3: 800", () => client.assert(item3.worksTotal == 800));
  client.test("итоги 3600 / 360 / 3240 / 2240", () => client.assert(
      b.worksTotal == 3600 && b.discountAmount == 360 && b.total == 3240 && b.amountDue == 2240,
      [b.worksTotal, b.discountAmount, b.total, b.amountDue].join(" / ")));
  client.test("note и dueDate обновлены", () => client.assert(b.note === "обновлён" && b.dueDate === "2026-12-05"));
  client.global.set("item3_id", item3.id);
  client.global.set("item3_clean_id", item3.works[0].id);
%}


### ============================================================ E. Ошибки создания
### E1 Несуществующая позиция справочника
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "client": {"fullName": "Регресс Тест", "phone": "{{phoneRaw}}"},
  "items": [{
    "categoryId": "{{cat_shoes}}", "itemTypeId": "{{type_boots}}", "warranty": false,
    "colorId": "{{$uuid}}",
    "works": [{"serviceTypeId": "{{svc_heel}}", "price": 1500}]
  }]
}

> {%
  const b = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
  client.test("400", () => client.assert(response.status === 400, "status " + response.status));
  client.test("items[0].colorId", () => client.assert(
      b.errors["items[0].colorId"] === "Нет такой позиции в справочнике COLOR", JSON.stringify(b.errors)));
%}

