{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve askshoes-frontend",
    "build": "npm run build-libs && ng build askshoes-frontend",
    "watch": "ng build argent-ui --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint argent-ui && ng lint askshoes-frontend",
    "lint:fix": "ng lint argent-ui --fix && ng lint askshoes-frontend --fix",
    "format": "prettier --write \"projects/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss}\"",
    "fetch-openapi-spec": "curl -s http://127.0.0.1:8080/v3/api-docs -o openapi.json",
    "generate-api": "npm run fetch-openapi-spec && openapi-generator-cli generate -i openapi.json -g typescript-angular -o projects/argent-api/src/lib --additional-properties=ngVersion=21.2.0,providedInRoot=true,npmName=argent-api,fileNaming=kebab-case",
    "build-libs": "ng build argent-api && ng build argent-ui"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.2",
    "@angular/compiler-cli": "^21.2.0",
    "@antfu/eslint-config": "^9.5.1",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
