### Регрессионный набор приёмки заказа (рефакторинг OrderService)
#
# Запуск: IntelliJ HTTP Client, окружение `local`, «Run All Requests in File».
# Логин/пароль — в http-client.private.env.json (см. *.example рядом, файл не коммитится).
#
# Справочники в БД пустые (seed создаёт только типы), поэтому блок 0 заводит позиции.
# Коды получают суффикс прогона {{run}} — файл можно гонять повторно; позиции копятся в БД.
#
# Ожидаемые значения сняты с поведения ДО рефакторинга. Единственный заведомо красный
# тест — помеченный [БАГ]: он станет зелёным, когда ошибки перестанут перезаписываться.

### 0.0 Логин
POST {{host}}/api/auth/login
Content-Type: application/json

{"username": "{{username}}", "password": "{{password}}"}

> {%
  client.test("логин 200", () => client.assert(response.status === 200, "status " + response.status));
  client.global.set("token", response.body.token);
  const run = Date.now().toString();
  client.global.set("run", run);
  // 11 цифр с ведущей 8 → нормализуется в 79XXXXXXXXX
  client.global.set("phoneRaw", "8 (9" + run.slice(-9, -7) + ") " + run.slice(-7));
  client.global.set("phone8", "89" + run.slice(-9));
  client.global.set("phoneNorm", "79" + run.slice(-9));
  client.global.set("phoneTail", run.slice(-7));
%}

### 0.1 ITEM_CATEGORY: обувь
POST {{host}}/api/refs/ITEM_CATEGORY
Authorization: Bearer {{token}}
Content-Type: application/json

{"code": "T{{run}}_SHOES", "name": "Обувь {{run}}", "active": true, "sortOrder": 1}

> {% client.test("200", () => client.assert(response.status === 200)); client.global.set("cat_shoes", response.body.id); %}

