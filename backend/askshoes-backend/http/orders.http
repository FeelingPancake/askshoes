### E10 Несколько ошибок сразу — все и в порядке полей формы
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "client": {"fullName": "Регресс Тест", "phone": "123", "contactMethodIds": ["{{$uuid}}"]},
  "items": [{
    "categoryId": "{{cat_shoes}}", "itemTypeId": "{{type_boots}}", "brandId": "{{brand_plain}}",
    "warranty": true, "colorId": "{{$uuid}}",
    "works": [{"serviceTypeId": "{{$uuid}}", "price": 1500}]
  }]
}

> {%
  const b = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
  client.test("400", () => client.assert(response.status === 400, "status " + response.status));
  const expected = [
    "client.phone",
    "client.contactMethodIds[0]",
    "items[0].colorId",
    "items[0].warranty",
    "items[0].works[0].serviceTypeId"
  ];
  client.test("все 5 ошибок в порядке полей", () => client.assert(
      JSON.stringify(Object.keys(b.errors)) === JSON.stringify(expected), JSON.stringify(Object.keys(b.errors))));
%}

### E11 [БАГ] Несуществующий размер у типа без сетки — должна остаться первая, точная ошибка
# Сейчас errors.put перезаписывает «Нет такой позиции…» на «У этого типа изделия нет размера».
# Тест красный до исправления (putIfAbsent в OrderValidation), затем должен стать зелёным.
POST {{host}}/api/orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "client": {"fullName": "Регресс Тест", "phone": "{{phoneRaw}}"},
  "items": [{
    "categoryId": "{{cat_bags}}", "itemTypeId": "{{type_bag}}", "warranty": false,
    "sizeId": "{{$uuid}}",
    "works": [{"serviceTypeId": "{{svc_clean}}", "price": 800}]
  }]
}

> {%
  const b = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
  client.test("400", () => client.assert(response.status === 400, "status " + response.status));
  client.test("[БАГ] items[0].sizeId — первая ошибка не перезаписана", () => client.assert(
      b.errors["items[0].sizeId"] === "Нет такой позиции в справочнике ITEM_SIZE", b.errors["items[0].sizeId"]));
%}

